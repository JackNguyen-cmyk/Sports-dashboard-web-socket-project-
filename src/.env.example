# Copy to .env and fill in. Never commit .env - it holds real credentials.

# Neon Postgres connection string (Neon Console -> Project -> Dashboard -> Connect)
DATABASE_URL="postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=verify-full"

# HTTP server
PORT=8000
HOST=0.0.0.0

# Arcjet (app.arcjet.com). ENV is which environment you are in;
# MODE is whether rules enforce (LIVE) or only log (DRY_RUN).
ARCJET_KEY=
ARCJET_ENV=development
ARCJET_MODE=LIVE

# APM Insight. Replaces the apminsightnode.json config file.
APMINSIGHT_LICENSE_KEY=
APMINSIGHT_APP_NAME="Websocket project"
APMINSIGHT_APP_PORT=10000
