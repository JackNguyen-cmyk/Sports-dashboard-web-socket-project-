# Copy to .env and fill in. Never commit .env - it holds real credentials.

# Neon Postgres connection string (Neon Console -> Project -> Dashboard -> Connect)
DATABASE_URL="postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=verify-full"

# HTTP server
PORT=8000
HOST=0.0.0.0

# Arcjet (app.arcjet.com). ENV is which environment you are in;
# MODE is whether rules enforce (LIVE) or only log (DRY_RUN).
#
# DRY_RUN still calls Arcjet over the network - it drops the enforcement, not
# the latency or the billing. To actually take Arcjet out of the request path
# (load testing), set ARCJET_ENABLED=false instead.
#
# ARCJET_ENABLED: only the exact string "false" disables. Any typo leaves
# protection ON, so a mistyped flag fails safe. Leave unset in normal use.
ARCJET_KEY=
ARCJET_ENV=development
ARCJET_MODE=LIVE
# ARCJET_ENABLED=false

# APM Insight. Replaces the apminsightnode.json config file.
APMINSIGHT_LICENSE_KEY=
APMINSIGHT_APP_NAME="Websocket project"
APMINSIGHT_APP_PORT=10000

# APMINSIGHT_AGENT_DISABLE: set to "true", or leave it UNSET. Never "false".
# The agent is inconsistent about how it reads this flag:
#   apminsight/index.js:23  (import-time init)  requires the value == "true"
#   apminsight/index.js:41  (AgentAPI.config()) tests the value for truthiness
# The string "false" is truthy, so APMINSIGHT_AGENT_DISABLE=false skips
# config() but still runs the import-time init - a half-started agent.
# APMINSIGHT_AGENT_DISABLE=true
